"<!DOCTYPE html>\n<html lang=\"fr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Carte des startups \u2014 Paris</title>\n<meta name=\"description\" content=\"D\u00e9couvrez sur une carte interactive de Paris les startups r\u00e9f\u00e9renc\u00e9es : localisation, secteur d'activit\u00e9 et lien vers chaque site.\">\n\n<!-- Leaflet (carte, sans cl\u00e9 API) -->\n<link rel=\"stylesheet\" href=\"https://unpkg.com/leaflet@1.9.4/dist/leaflet.css\"\n      integrity=\"sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=\" crossorigin=\"\">\n<!-- Polices Snapdesk -->\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Josefin+Sans:wght@500;600;700&family=DM+Sans:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n\n<style>\n  :root{\n    --pink:#E590A1; --sage:#A9BCB7; --ink:#111111;\n    --bg:#f4f6f5; --panel:#ffffff; --line:#e7e9e8; --muted:#6b7280;\n    --radius:16px; --shadow:0 10px 40px rgba(17,17,17,.16);\n    --title:\"Josefin Sans\",-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;\n    --body:\"DM Sans\",-apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,Arial,sans-serif;\n  }\n  *{box-sizing:border-box}\n  html,body{margin:0;height:100%}\n  body{font-family:var(--body);color:var(--ink);background:var(--bg)}\n\n  /* ---------- Layout plein \u00e9cran ---------- */\n  .map-app{position:relative;width:100%;height:100vh;min-height:520px;overflow:hidden}\n  #map{position:absolute;inset:0;z-index:1;background:var(--sage)}\n  .leaflet-container{font-family:var(--body)}\n\n  /* ---------- Barre de recherche ---------- */\n  .search{position:absolute;z-index:600;top:18px;left:18px;width:min(360px,calc(100% - 36px))}\n  .search-box{display:flex;align-items:center;gap:10px;background:var(--panel);\n    border:1px solid var(--line);border-radius:14px;padding:12px 14px;box-shadow:var(--shadow)}\n  .search-box svg{flex:none;color:var(--muted)}\n  .search-box input{border:0;outline:0;width:100%;font-family:var(--body);font-size:15px;color:var(--ink);background:transparent}\n  .search-box input::placeholder{color:var(--muted)}\n  .search-clear{border:0;background:transparent;color:var(--muted);cursor:pointer;font-size:18px;line-height:1;padding:2px;display:none}\n  .search-clear.show{display:block}\n  .results{margin-top:8px;background:var(--panel);border:1px solid var(--line);border-radius:14px;\n    box-shadow:var(--shadow);overflow:hidden;max-height:min(52vh,420px);overflow-y:auto;display:none}\n  .results.show{display:block}\n  .result{display:flex;align-items:center;gap:11px;padding:10px 13px;cursor:pointer;border-bottom:1px solid var(--line)}\n  .result:last-child{border-bottom:0}\n  .result:hover,.result.active{background:#faf5f6}\n  .result .r-logo{width:34px;height:34px;border-radius:9px;object-fit:contain;background:#fff;border:1px solid var(--line);flex:none}\n  .result .r-txt{min-width:0}\n  .result .r-name{font-weight:600;font-size:14px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n  .result .r-sector{font-size:12px;color:var(--muted)}\n  .no-result{padding:14px 15px;color:var(--muted);font-size:14px}\n\n  /* ---------- Marqueurs (logos) ---------- */\n  .pin{position:relative;width:46px;height:46px;transform:translateY(-4px)}\n  .pin .disc{width:46px;height:46px;border-radius:50%;background:#fff;border:3px solid var(--pink);\n    box-shadow:0 4px 12px rgba(17,17,17,.22);overflow:hidden;display:flex;align-items:center;justify-content:center;\n    transition:transform .12s ease, border-color .12s ease}\n  .pin .disc img{width:100%;height:100%;object-fit:contain;padding:5px}\n  .pin .disc .initials{font-family:var(--title);font-weight:700;font-size:16px;color:var(--ink)}\n  .pin .tip{position:absolute;left:50%;bottom:-6px;width:12px;height:12px;background:#fff;border-right:3px solid var(--pink);\n    border-bottom:3px solid var(--pink);transform:translateX(-50%) rotate(45deg)}\n  .pin:hover .disc, .pin.is-active .disc{transform:scale(1.08);border-color:var(--ink)}\n  .pin.is-active .tip{border-color:var(--ink)}\n\n  /* ---------- Panneau de droite ---------- */\n  .panel{position:absolute;z-index:700;top:0;right:0;height:100%;width:min(380px,88%);\n    background:var(--panel);box-shadow:-14px 0 40px rgba(17,17,17,.18);\n    transform:translateX(105%);transition:transform .32s cubic-bezier(.22,.61,.36,1);\n    display:flex;flex-direction:column}\n  .panel.open{transform:translateX(0)}\n  .panel .p-close{position:absolute;top:14px;right:14px;z-index:2;border:0;background:rgba(255,255,255,.85);\n    width:36px;height:36px;border-radius:50%;cursor:pointer;font-size:20px;line-height:1;color:var(--ink);\n    box-shadow:0 2px 8px rgba(17,17,17,.15)}\n  .panel .p-head{padding:34px 26px 22px;background:linear-gradient(180deg,#fbeef1 0%,#fff 100%);border-bottom:1px solid var(--line)}\n  .panel .p-logo{width:88px;height:88px;border-radius:20px;background:#fff;border:1px solid var(--line);\n    box-shadow:0 6px 18px rgba(17,17,17,.10);object-fit:contain;padding:10px;margin-bottom:16px}\n  .panel .p-logo.initials{display:flex;align-items:center;justify-content:center;font-family:var(--title);font-weight:700;font-size:34px}\n  .panel .p-name{font-family:var(--title);font-weight:700;font-size:26px;margin:0 0 10px;line-height:1.15}\n  .panel .badge{display:inline-flex;align-items:center;gap:7px;background:var(--sage);color:#173430;\n    font-weight:600;font-size:13px;padding:6px 12px;border-radius:999px}\n  .panel .badge::before{content:\"\";width:7px;height:7px;border-radius:50%;background:#173430}\n  .panel .p-body{padding:22px 26px;overflow-y:auto;flex:1}\n  .panel .p-row{margin-bottom:18px}\n  .panel .p-row .k{font-size:11px;text-transform:uppercase;letter-spacing:.6px;color:var(--muted);font-weight:600;margin-bottom:5px}\n  .panel .p-row .v{font-size:15px;color:var(--ink)}\n  .panel .p-row .v a{color:var(--pink);text-decoration:none;font-weight:600;word-break:break-all}\n  .panel .p-row .v a:hover{text-decoration:underline}\n  .panel .p-cta{display:flex;align-items:center;justify-content:center;gap:9px;width:100%;\n    background:var(--ink);color:#fff;text-decoration:none;font-family:var(--title);font-weight:600;font-size:16px;\n    padding:15px;border-radius:12px;transition:.15s}\n  .panel .p-cta:hover{background:var(--pink);color:var(--ink)}\n\n  /* Compteur discret */\n  .count{position:absolute;z-index:500;left:18px;bottom:24px;background:var(--panel);border:1px solid var(--line);\n    border-radius:999px;padding:8px 15px;font-size:13px;font-weight:600;color:var(--ink);box-shadow:var(--shadow)}\n  .count b{color:var(--pink)}\n\n  /* Zoom Leaflet un peu plus doux */\n  .leaflet-control-zoom a{border-radius:8px!important}\n  .leaflet-bar{border:none!important;box-shadow:var(--shadow)!important}\n\n  /* ---------- Mobile : panneau = feuille du bas ---------- */\n  @media (max-width:640px){\n    .panel{top:auto;bottom:0;right:0;width:100%;height:min(72%,540px);\n      border-radius:22px 22px 0 0;transform:translateY(105%)}\n    .panel.open{transform:translateY(0)}\n    .panel .p-head{padding-top:26px}\n    .count{display:none}\n  }\n</style>\n</head>\n<body>\n\n<div class=\"map-app\">\n  <div id=\"map\"></div>\n\n  <!-- Recherche -->\n  <div class=\"search\">\n    <div class=\"search-box\">\n      <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><circle cx=\"11\" cy=\"11\" r=\"7\"></circle><path d=\"m21 21-4.3-4.3\"></path></svg>\n      <input id=\"q\" type=\"text\" placeholder=\"Rechercher une startup\u2026\" autocomplete=\"off\">\n      <button class=\"search-clear\" id=\"qClear\" aria-label=\"Effacer\">\u00d7</button>\n    </div>\n    <div class=\"results\" id=\"results\"></div>\n  </div>\n\n  <!-- Panneau de d\u00e9tails -->\n  <aside class=\"panel\" id=\"panel\" aria-hidden=\"true\">\n    <button class=\"p-close\" id=\"pClose\" aria-label=\"Fermer\">\u00d7</button>\n    <div class=\"p-head\">\n      <div id=\"pLogo\"></div>\n      <h2 class=\"p-name\" id=\"pName\"></h2>\n      <span class=\"badge\" id=\"pSector\"></span>\n    </div>\n    <div class=\"p-body\">\n      <div class=\"p-row\">\n        <div class=\"k\">Site web</div>\n        <div class=\"v\" id=\"pLinkRow\"></div>\n      </div>\n      <a class=\"p-cta\" id=\"pCta\" target=\"_blank\" rel=\"noopener\">\n        Visiter le site\n        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M7 17 17 7\"></path><path d=\"M7 7h10v10\"></path></svg>\n      </a>\n    </div>\n  </aside>\n\n  <div class=\"count\" id=\"count\"></div>\n</div>\n\n<script src=\"https://unpkg.com/leaflet@1.9.4/dist/leaflet.js\"\n        integrity=\"sha256-20nQCchB9co0qIjJ5eGU+9rf8jvKmZ8ymJl1H+STHUg=\" crossorigin=\"\"></script>\n<script>\n/* =====================================================================\n   DONN\u00c9ES DES STARTUPS  \u2014  \u00c0 REMPLACER PAR VOTRE LISTE\n   ---------------------------------------------------------------------\n   Chaque startup :\n     name    : nom affich\u00e9\n     sector  : secteur d'activit\u00e9 (ex. \"Fintech\", \"Sant\u00e9\"\u2026)\n     url     : lien du site (avec https://)\n     logo    : URL d'un logo (png/svg). Laissez \"\" -> initiales affich\u00e9es.\n     lat,lng : coordonn\u00e9es GPS.  Astuce : clic droit sur Google Maps\n               -> les 2 nombres affich\u00e9s sont \"lat, lng\".\n   ===================================================================== */\nconst STARTUPS = [\n  { name:\"Alan\",        sector:\"Assurance sant\u00e9\", url:\"https://alan.com\",\n    logo:\"https://logo.clearbit.com/alan.com\",       lat:48.8709, lng:2.3620 },\n  { name:\"Doctolib\",    sector:\"HealthTech\",      url:\"https://www.doctolib.fr\",\n    logo:\"https://logo.clearbit.com/doctolib.fr\",    lat:48.8918, lng:2.2380 },\n  { name:\"Qonto\",       sector:\"Fintech\",         url:\"https://qonto.com\",\n    logo:\"https://logo.clearbit.com/qonto.com\",      lat:48.8666, lng:2.3630 },\n  { name:\"Back Market\", sector:\"E-commerce\",      url:\"https://www.backmarket.fr\",\n    logo:\"https://logo.clearbit.com/backmarket.fr\",  lat:48.8656, lng:2.3510 },\n  { name:\"PayFit\",      sector:\"HR Tech\",         url:\"https://payfit.com\",\n    logo:\"https://logo.clearbit.com/payfit.com\",     lat:48.8845, lng:2.3210 },\n  { name:\"Swile\",       sector:\"Fintech / RH\",    url:\"https://www.swile.co\",\n    logo:\"https://logo.clearbit.com/swile.co\",       lat:48.8600, lng:2.3760 },\n];\n\n/* Centre & zoom initial (Paris) */\nconst PARIS = [48.8566, 2.3522];\nconst ZOOM  = 12.4;\n\n/* --------------------------------------------------------------------- */\nconst map = L.map('map', { zoomControl:true, scrollWheelZoom:true, minZoom:11, maxZoom:18 })\n             .setView(PARIS, ZOOM);\nmap.zoomControl.setPosition('bottomright');\n\n/* Fond de carte clair et sobre (CARTO \u2014 gratuit, sans cl\u00e9) */\nL.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {\n  attribution:'&copy; <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a> &copy; <a href=\"https://carto.com/attributions\">CARTO</a>',\n  subdomains:'abcd', maxZoom:19\n}).addTo(map);\n\nfunction initials(name){\n  return name.trim().split(/\\s+/).slice(0,2).map(w=>w[0]).join('').toUpperCase();\n}\nfunction logoImg(s, cls){\n  if(s.logo){\n    return `<img class=\"${cls}\" src=\"${s.logo}\" alt=\"${s.name}\"\n      onerror=\"this.replaceWith(Object.assign(document.createElement('div'),{className:'${cls} initials',textContent:'${initials(s.name)}'}))\">`;\n  }\n  return `<div class=\"${cls} initials\">${initials(s.name)}</div>`;\n}\n\n/* --- Cr\u00e9ation des marqueurs --- */\nconst markers = [];\nSTARTUPS.forEach((s, i)=>{\n  const html = `<div class=\"pin\" data-i=\"${i}\"><div class=\"disc\">${logoImg(s,'')}</div><div class=\"tip\"></div></div>`;\n  const icon = L.divIcon({ className:'pin-wrap', html, iconSize:[46,46], iconAnchor:[23,50], popupAnchor:[0,-48] });\n  const m = L.marker([s.lat, s.lng], { icon, title:s.name, riseOnHover:true }).addTo(map);\n  m.on('click', ()=> select(i, true));\n  markers.push(m);\n});\n\n/* Ajuste la vue pour englober tous les points */\nif(markers.length){\n  const group = L.featureGroup(markers);\n  map.fitBounds(group.getBounds().pad(0.18));\n}\n\n/* --- Panneau de d\u00e9tails --- */\nconst panel   = document.getElementById('panel');\nconst pClose  = document.getElementById('pClose');\nlet activeIndex = -1;\n\nfunction setActivePin(i){\n  document.querySelectorAll('.pin').forEach(p=>p.classList.remove('is-active'));\n  if(i>-1){\n    const el = document.querySelector('.pin[data-i=\"'+i+'\"]');\n    if(el) el.classList.add('is-active');\n  }\n}\n\nfunction openPanel(s){\n  document.getElementById('pLogo').outerHTML =\n    (s.logo ? `<img id=\"pLogo\" class=\"p-logo\" src=\"${s.logo}\" alt=\"${s.name}\"\n        onerror=\"this.outerHTML='<div id=\\\\'pLogo\\\\' class=\\\\'p-logo initials\\\\'>${initials(s.name)}</div>'\">`\n            : `<div id=\"pLogo\" class=\"p-logo initials\">${initials(s.name)}</div>`);\n  document.getElementById('pName').textContent   = s.name;\n  document.getElementById('pSector').textContent = s.sector || '\u2014';\n  const host = s.url.replace(/^https?:\\/\\//,'').replace(/\\/$/,'');\n  document.getElementById('pLinkRow').innerHTML  = `<a href=\"${s.url}\" target=\"_blank\" rel=\"noopener\">${host}</a>`;\n  document.getElementById('pCta').href           = s.url;\n  panel.classList.add('open');\n  panel.setAttribute('aria-hidden','false');\n}\nfunction closePanel(){\n  panel.classList.remove('open');\n  panel.setAttribute('aria-hidden','true');\n  setActivePin(-1);\n  activeIndex = -1;\n}\npClose.addEventListener('click', closePanel);\ndocument.addEventListener('keydown', e=>{ if(e.key==='Escape') closePanel(); });\n\n/* S\u00e9lection d'une startup (depuis marqueur ou recherche) */\nfunction select(i, fromMarker){\n  const s = STARTUPS[i];\n  activeIndex = i;\n  setActivePin(i);\n  openPanel(s);\n  const targetZoom = Math.max(map.getZoom(), 14.5);\n  map.flyTo([s.lat, s.lng], targetZoom, { duration:.7 });\n  if(!fromMarker){ closeResults(); document.getElementById('q').value = s.name; toggleClear(); }\n}\n\n/* --- Recherche --- */\nconst q       = document.getElementById('q');\nconst qClear  = document.getElementById('qClear');\nconst results = document.getElementById('results');\n\nfunction toggleClear(){ qClear.classList.toggle('show', q.value.length>0); }\nfunction closeResults(){ results.classList.remove('show'); results.innerHTML=''; }\n\nfunction renderResults(list){\n  if(!q.value.trim()){ closeResults(); return; }\n  if(!list.length){\n    results.innerHTML = `<div class=\"no-result\">Aucune startup trouv\u00e9e.</div>`;\n    results.classList.add('show'); return;\n  }\n  results.innerHTML = list.map(({s,i})=>`\n    <div class=\"result\" data-i=\"${i}\">\n      ${logoImg(s,'r-logo')}\n      <div class=\"r-txt\">\n        <div class=\"r-name\">${s.name}</div>\n        <div class=\"r-sector\">${s.sector||''}</div>\n      </div>\n    </div>`).join('');\n  results.classList.add('show');\n  results.querySelectorAll('.result').forEach(el=>{\n    el.addEventListener('click', ()=> select(+el.dataset.i, false));\n  });\n}\n\nfunction search(term){\n  const t = term.trim().toLowerCase();\n  return STARTUPS.map((s,i)=>({s,i}))\n    .filter(({s})=> s.name.toLowerCase().includes(t) || (s.sector||'').toLowerCase().includes(t));\n}\n\nq.addEventListener('input', ()=>{ toggleClear(); renderResults(search(q.value)); });\nq.addEventListener('focus', ()=>{ if(q.value.trim()) renderResults(search(q.value)); });\nq.addEventListener('keydown', e=>{\n  if(e.key==='Enter'){\n    const first = results.querySelector('.result');\n    if(first) select(+first.dataset.i, false);\n  }\n});\nqClear.addEventListener('click', ()=>{ q.value=''; toggleClear(); closeResults(); q.focus(); });\ndocument.addEventListener('click', e=>{ if(!e.target.closest('.search')) closeResults(); });\n\n/* Compteur */\ndocument.getElementById('count').innerHTML = `<b>${STARTUPS.length}</b> startups r\u00e9f\u00e9renc\u00e9es`;\n</script>\n</body>\n</html>\n"